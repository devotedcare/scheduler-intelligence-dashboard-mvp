# ==============================================================
# Environment variables — copy the names, not this file.
#
# These are set in the Netlify UI:
#   Site configuration > Environment variables > Add a variable
#
# Do NOT commit a filled-in .env. .gitignore already blocks it.
# ==============================================================


# ---- Supabase (shared scheduler data) -------------------------
# Supabase dashboard > Project Settings > Data API

# Project URL. No trailing slash, no /rest/v1.
SUPABASE_URL=https://your-project-ref.supabase.co

# The ANON / publishable key — NOT the service_role key.
# This one is public by design and ships to the browser.
# The service_role key must never leave the server.
SUPABASE_ANON_KEY=eyJhbGciOi...

# Optional. Change only to run a second isolated copy of the app
# (for example a training sandbox) off the same Supabase project.
SCHEDULER_WORKSPACE=devoted_care
SCHEDULER_TABLE=scheduler_state

# Care-notes sync ONLY. Server-side, never sent to a browser.
# Supabase dashboard > Project Settings > API > service_role.
# It bypasses row-level security, so it must never appear in
# config.js, index.html, or any client-side file.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. How often to check for another scheduler's changes, in ms.
# Minimum 8000. Default 20000.
SCHEDULER_POLL_MS=20000


# ---- AxisCare (server-side only — never reaches the browser) --
# Names match the Client Concierge dashboard so both projects
# configure AxisCare identically.

# Your agency's AxisCare site, no trailing slash.
AXISCARE_SITE_URL=

# The secret token. Only ever read inside netlify/functions/axiscare.js.
AXISCARE_API_TOKEN=

# Required by AxisCare on every request as the X-AxisCare-Api-Version
# header. Omitting it returns 400 "Unsupported version" — and that
# check runs BEFORE auth, so a wrong value masks every other error.
# Leave unset to use the default below.
AXISCARE_API_VERSION=2023-10-01

# Optional. Comma-separated path prefixes the proxy may call, which
# stops the function becoming an open proxy. Leave unset to use the
# built-in list (caregivers, clients, visits, schedules, contacts,
# applicants, call-logs, adls, organizations, taggingCategories, classes).
# AXISCARE_ALLOWED_PATHS=/api/caregivers,/api/clients,/api/visits,/api/schedules


# ---- Quo — the phone system (SUPABASE secrets, not Netlify) ---
# Quo was called OpenPhone until the 2026 rebrand, so anything you
# read about the OpenPhone API describes this one.
#
# NOTE THE STORE. Everything above is a Netlify environment
# variable. These are NOT — they are Supabase project secrets,
# because that is where the key was put and the function that
# reads it is a Supabase Edge Function
# (supabase/functions/quo/index.ts), like devi-agent.
#
#   Supabase dashboard > Project Settings > Edge Functions > Secrets
#
# A COMMIT DOES NOT DEPLOY THAT FUNCTION. After changing it:
#   npx supabase functions deploy quo --no-verify-jwt

# The secret API key. Generated in Quo under workspace settings >
# API. Needs workspace Owner or Admin rights, and the key NAME may
# not contain spaces.
#
# It is sent as the RAW Authorization header value. Quo's docs say
# it does not use a Bearer token — measured 2026-09-11 a Bearer
# prefix also works, but the documented raw form is what we send.
#
# THE KEY HAS NO SCOPES. The same key that reads messages can also
# send them and delete contacts. The read-only boundary is the
# GET-only method gate in quo/index.ts, not the key — which is why
# that gate must not grow a POST branch.
QUO_API_KEY=

# Optional. The API root. NO trailing slash and NO /v1 — every
# allowlisted path already starts /v1/, and doubling it gives
# /v1/v1/... and a 404. Only set this if Quo moves the URL.
QUO_API_BASE=https://api.quo.com

# Optional. Comma-separated path prefixes the proxy may call. Leave
# unset for the built-in read-only list. Only ever add a GET route.
# QUO_ALLOWED_PATHS=/v1/phone-numbers,/v1/users

# Optional. If set, the function requires a matching X-Quo-Secret
# header. Worth knowing what this does and does not buy: it stops
# casual URL discovery, but the dashboard has no login, so any
# value the BROWSER would have to send is public anyway. It is
# real protection only for a server-to-server caller.
QUO_SHARED_SECRET=

# Reused from devi-agent, not a new variable — the Quo function
# reads the same ALLOWED_ORIGIN secret for its CORS allow-list.
